adding:6px}.chat{flex:1;padding:16px 12px}.bubble{display:inline-block;max-width:82%;background:#fff;padding:8px 10px;border-radius:8px;border-top-left-radius:2px;box-shadow:0 1px 1px rgba(0,0,0,.1);font-size:14px}.controls{background:#f0f2f5;padding:8px}.wa-buttons{background:#fff;border-radius:8px;overflow:hidden;margin-bottom:7px}.wa-buttons form{margin:0}.wa-buttons button{width:100%;border:0;border-top:1px solid #e6e9e7;background:#fff;color:#008069;padding:12px;font-weight:700}.wa-buttons form:first-child button{border-top:0}.composer{display:flex;gap:7px}.composer input{flex:1;border:0;background:#fff;border-radius:22px;padding:11px 14px;outline:none}.composer button{width:43px;height:43px;border:0;border-radius:50%;background:#00a884;color:#fff}.micro{font-size:10px;color:#748079;padding:5px 4px}@media(max-width:830px){.stage{grid-template-columns:1fr}.copy{display:none}.phone{height:88vh}}</style></head><body><div class=\"stage\"><div class=\"copy\"><small>BIZI SYSTEMS · CLIENT DEMO</small><h1>Favfare Patient Assistant</h1><p>A conversation-first WhatsApp receptionist sandbox: book appointments, browse server-backed services and prices, or make an enquiry.</p><a href=\"/webhook/favfare-demo/crm-ui-v2\" target=\"_blank\">Open staff CRM ↗</a></div><section class=\"phone\"><div class=\"bar\"><div class=\"avatar\">F</div><div><b>Favfare The Clinic</b><span>online</span></div></div><div class=\"notice\">Sandbox · mirrors the planned WhatsApp conversation</div><div class=\"chat\"><div class=\"bubble\">Hi 👋 Welcome to Favfare. How can I help you today?</div></div><div class=\"controls\"><div class=\"wa-buttons\">${flow('Book an appointment','start_booking')}${flow('View services & prices','browse_services')}${flow('Make an enquiry','chat','I have an enquiry')}</div><form class=\"composer\" method=\"post\" action=\"${action}\">${h('action','chat')}${h('session_id',sid)}<input name=\"message\" placeholder=\"Message\" autocomplete=\"off\" required><button>➤</button><