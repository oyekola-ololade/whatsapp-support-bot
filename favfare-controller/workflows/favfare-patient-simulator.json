        "respondWith": "text",
        "responseBody": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Favfare Patient Assistant</title><style>*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#eef2ef;color:#16251f}.shell{min-height:100vh;display:grid;grid-template-columns:minmax(0,1fr) 390px}.stage{padding:34px;display:flex;align-items:center;justify-content:center}.intro{max-width:520px}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#4e6a5d}.intro h1{font-size:42px;line-height:1.02;margin:12px 0 16px;letter-spacing:-.04em}.intro p{color:#5d6b65;line-height:1.7}.demo-card{margin-top:28px;background:#fff;border:1px solid #dfe7e2;border-radius:18px;padding:18px;box-shadow:0 10px 40px rgba(24,55,42,.06)}.demo-card strong{display:block;margin-bottom:6px}.demo-card span{font-size:13px;color:#66736d}.opencrm{display:inline-flex;margin-top:18px;padding:11px 15px;border-radius:10px;background:#163c2c;color:white;text-decoration:none;font-weight:700;font-size:13px}.phone-wrap{background:#dce6df;padding:22px;display:flex;align-items:center;justify-content:center}.phone{width:100%;height:min(790px,calc(100vh - 44px));background:#efeae2;border-radius:26px;overflow:hidden;box-shadow:0 24px 70px rgba(16,50,36,.2);display:flex;flex-direction:column;border:1px solid rgba(0,0,0,.08)}.topbar{height:72px;background:#075e54;color:#fff;display:flex;align-items:center;padding:0 16px;gap:12px}.avatar{width:42px;height:42px;border-radius:50%;background:#fff;color:#0b695c;display:grid;place-items:center;font-weight:900}.title strong{display:block;font-size:15px}.title span{font-size:12px;opacity:.78}.messages{flex:1;padding:18px 14px;overflow:auto;background-image:radial-gradient(rgba(0,0,0,.025) 1px,transparent 1px);background-size:18px 18px}.msg{display:flex;margin:8px 0}.msg.patient{justify-content:flex-end}.bubble{max-width:82%;padding:9px 11px;border-radius:9px;box-shadow:0 1px 1px rgba(0,0,0,.08);font-size:14px;line-height:1.45;white-space:pre-wrap}.assistant .bubble{background:#fff;border-top-left-radius:2px}.patient .bubble{background:#d9fdd3;border-top-right-radius:2px}.meta{font-size:10px;color:#829089;text-align:right;margin-top:4px}.quick{display:flex;flex-wrap:wrap;gap:7px;margin:8px 0}.quick button{border:1px solid #a9c7b8;background:#fff;color:#17664f;padding:8px 10px;border-radius:999px;font-size:12px;font-weight:700;cursor:pointer}.typing{display:none;margin:8px 0}.typing .bubble{color:#6f7d76}.composer{background:#f0f2f5;padding:10px;display:flex;gap:8px}.composer input{flex:1;border:0;border-radius:22px;padding:12px 15px;font-size:14px;outline:none;background:white}.composer button{width:44px;height:44px;border:0;border-radius:50%;background:#00a884;color:#fff;font-size:18px;cursor:pointer}.statusbar{padding:7px 12px;background:#fff8d8;color:#755b00;font-size:11px;text-align:center;border-bottom:1px solid #eadca1}.error{background:#ffe8e8;color:#882b2b}.hidden{display:none}@media(max-width:900px){.shell{display:block}.stage{padding:22px}.intro h1{font-size:32px}.phone-wrap{padding:12px}.phone{height:78vh;border-radius:18px}}</style></head><body><div class=\"shell\"><section class=\"stage\"><div class=\"intro\"><div class=\"eyebrow\">Bizi Systems · Sales Demo</div><h1>Favfare Patient Assistant</h1><p>This simulator uses the real Favfare demo backend. Ask for the price of scaling and polishing, request an appointment, choose a live available slot, and watch the enquiry appear in the staff CRM.</p><div class=\"demo-card\"><strong>Suggested demo script</strong><span>1. Ask “How much is scaling and polishing?”<br>2. Tap “I’d like to book”<br>3. Choose next Monday<br>4. Pick an available time<br>5. Open the staff CRM to confirm the request</span><br><a class=\"opencrm\" href=\"/webhook/favfare-demo/crm-ui\" target=\"_blank\">Open staff CRM →</a></div></div></section><aside class=\"phone-wrap\"><div class=\"phone\"><div class=\"topbar\"><div class=\"avatar\">F</div><div class=\"title\"><strong>Favfare The Clinic</strong><span>Patient Assistant · online</span></div></div><div id=\"status\" class=\"statusbar\">Demo environment · appointment requests require staff confirmation</div><div id=\"messages\" class=\"messages\"></div><div id=\"typing\" class=\"typing messages\" style=\"flex:none;padding:0 14px\"><div class=\"msg assistant\"><div class=\"bubble\">Typing…</div></div></div><div class=\"composer\"><input id=\"input\" autocomplete=\"off\" placeholder=\"Type a message\"><button id=\"send\">➤</button></div></div></aside></div><script>(function(){var M=document.getElementById('messages'),I=document.getElementById('input'),S=document.getElementById('send'),T=document.getElementById('typing'),STATUS=document.getElementById('status');var state={enquiryId:null,date:null,slots:[],stage:'start'};var sid=sessionStorage.getItem('favfareDemoSid');if(!sid){sid='sim-'+Date.now()+'-'+Math.floor(Math.random()*9999);sessionStorage.setItem('favfareDemoSid',sid)}function time(){return new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}function msg(text,who){var row=document.createElement('div');row.className='msg '+(who==='patient'?'patient':'assistant');var b=document.createElement('div');b.className='bubble';b.textContent=text;var meta=document.createElement('div');meta.className='meta';meta.textContent=time();b.appendChild(meta);row.appendChild(b);M.appendChild(row);M.scrollTop=M.scrollHeight}function quick(items){var q=document.createElement('div');q.className='quick';items.forEach(function(x){var b=document.createElement('button');b.textContent=x.label;b.onclick=function(){q.remove();sendText(x.text,x.value)};q.appendChild(b)});M.appendChild(q);M.scrollTop=M.scrollHeight}function typing(on){T.style.display=on?'block':'none'}async function post(path,body){var r=await fetch(path,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});var d=await r.json();if(!r.ok)throw new Error(d.reply||d.error||('HTTP '+r.status));return d}function nextMonday(){var d=new Date();var day=d.getDay();var add=(8-day)%7;if(add===0)add=7;d.setDate(d.getDate()+add);return d.toISOString().slice(0,10)}function prettyDate(iso){var d=new Date(iso+'T12:00:00');return d.toLocaleDateString([],{weekday:'long',day:'numeric',month:'short'})}async function sendText(text,value){text=String(text||'').trim();if(!text)return;msg(text,'patient');I.value='';typing(true);try{await new Promise(function(r){setTimeout(r,450)});var low=text.toLowerCase();if(!state.enquiryId&&(low.indexOf('scaling')>=0||low.indexOf('polishing')>=0)){var q=await post('/webhook/favfare-demo/quote',{message:text,full_name:'Patient Demo',phone:'+23480000'+String(Math.floor(Math.random()*9000)+1000),whatsapp_id:sid});state.enquiryId=q.enquiry_id;state.stage='quoted';msg(q.reply||'Scaling and polishing is ₦25,000. Would you like to request an appointment?','assistant');quick([{label:'I’d like to book',text:'Yes, I’d like to book'}]);return}if(state.enquiryId&&(low.indexOf('book')>=0||state.stage==='quoted')){state.stage='date';var monday=nextMonday();msg('Sure. What day would you prefer? I can check the demo clinic availability for you.','assistant');quick([{label:prettyDate(monday),text:prettyDate(monday),value:monday}]);return}if(state.stage==='date'){var date=value||nextMonday();state.date=date;var a=await post('/webhook/favfare-demo/booking',{action:'availability_for_date',preferred_date:date,enquiry_id:state.enquiryId});state.slots=(a.slots||[]).slice(0,6);state.stage='time';if(!a.is_open||!state.slots.length){msg(a.reply||'There are no demo slots available on that date. Please choose another day.','assistant');return}msg('I found these available times for '+prettyDate(date)+'. Which works best for you?','assistant');quick(state.slots.map(function(x){var s=String(x).slice(0,5);return{label:s,text:s,value:s}}));return}if(state.stage==='time'){var slot=value||text.slice(0,5);var b=await post('/webhook/favfare-demo/booking',{action:'request_booking',enquiry_id:state.enquiryId,preferred_date:state.date,preferred_time:slot});if(b.ok){state.stage='requested';msg(b.reply||('Your appointment request for '+prettyDate(state.date)+' at '+slot+' has been recorded. A Favfare team member will confirm the booking.'),'assistant');msg('You can keep chatting here while the team reviews your request.','assistant')}else{msg(b.reply||'That slot is no longer available. Please choose another time.','assistant');var alt=(b.alternatives||[]).slice(0,6);if(alt.length)quick(alt.map(function(x){var s=String(x).slice(0,5);return{label:s,text:s,value:s}}))}return}if(low.indexOf('price')>=0||low.indexOf('how much')>=0){msg('For this demo, ask me: “How much is scaling and polishing?”','assistant');return}msg('For this sales demo I can show the live Scaling & Polishing price and appointment-request flow. Try: “How much is scaling and polishing?”','assistant')}catch(e){STATUS.textContent='Demo backend error · '+e.message;STATUS.className='statusbar error';msg('I could not complete that demo request. Please try again.','assistant')}finally{typing(false)}}S.onclick=function(){sendText(I.value)};I.addEventListener('keydown',function(e){if(e.key==='Enter')sendText(I.value)});msg('Hello 👋 Welcome to Favfare The Clinic. How may I help you today?','assistant');quick([{label:'Scaling & Polishing price',text:'How much is scaling and polishing?'}])})();</script></body></html>",
