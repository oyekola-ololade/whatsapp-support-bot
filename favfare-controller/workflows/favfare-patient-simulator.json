{"name":"Favfare Demo — Patient Simulator","active":true,"nodes":[{"parameters":{"httpMethod":"GET","path":"favfare-demo/patient","responseMode":"responseNode","options":{}},"id":"8e38a232-7643-465c-93e0-a2a5f4fd0a13","name":"Patient Simulator","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-220,0],"webhookId":"69a325fb-e040-47cb-a450-956f363adabb"},{"parameters":{"respondWith":"text","responseBody":"<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Favfare Patient Assistant</title><style>*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#e7eee9;color:#17241e;min-height:100vh;display:grid;place-items:center;padding:22px}.wrap{width:min(1050px,100%);display:grid;grid-template-columns:1fr 400px;gap:38px;align-items:center}.intro small{font-weight:850;letter-spacing:.14em;color:#426454}.intro h1{font-size:44px;letter-spacing:-.04em;margin:10px 0}.intro p{color:#65716b;line-height:1.7;max-width:560px}.note{background:white;padding:18px;border-radius:18px;margin-top:24px;border:1px solid #d9e3dc}.note span{font-size:12px;color:#6a756f}.crm{display:inline-block;margin-top:16px;color:#2e5b49;font-weight:750;text-decoration:none}.phone{height:760px;max-height:90vh;background:#efeae2;border-radius:26px;overflow:hidden;box-shadow:0 24px 70px rgba(16,50,36,.22);display:flex;flex-direction:column}.top{background:#075e54;color:white;padding:14px 16px;display:flex;gap:12px;align-items:center}.avatar{width:42px;height:42px;border-radius:50%;background:white;color:#075e54;display:grid;place-items:center;font-weight:900}.top strong{display:block}.top span{font-size:12px;opacity:.82}.status{font-size:11px;padding:7px 12px;background:#fff7cf;text-align:center;color:#715800}.chat{flex:1;overflow:auto;padding:18px 14px;background-image:radial-gradient(rgba(0,0,0,.025) 1px,transparent 1px);background-size:18px 18px}.msg{display:flex;margin:9px 0}.bubble{max-width:84%;padding:10px 12px;border-radius:9px;line-height:1.45;font-size:14px;box-shadow:0 1px 1px rgba(0,0,0,.08);background:white;border-top-left-radius:2px}.controls{padding:10px;background:#f0f2f5}.quick{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:8px}.quick form{margin:0}.quick button{width:100%;min-height:40px;border:1px solid #a9c7b8;background:white;color:#12624c;padding:8px;border-radius:12px;font-weight:750;cursor:pointer}.composer{display:flex;gap:8px}.composer input{flex:1;border:0;border-radius:22px;padding:12px 15px;font-size:14px;outline:none}.composer button{width:44px;height:44px;border:0;border-radius:50%;background:#00a884;color:white;font-size:18px;cursor:pointer}.detected{font-size:10px;color:#6f7c76;margin:5px 4px 0}.detected strong{color:#426454}@media(max-width:850px){.wrap{grid-template-columns:1fr}.intro h1{font-size:34px}.phone{height:78vh}}</style></head><body><div class=\"wrap\"><section class=\"intro\"><small>BIZI SYSTEMS · LIVE SALES DEMO</small><h1>Favfare Patient Assistant</h1><p>A conversational WhatsApp-style sales assistant: it understands what the patient wants, asks one useful question at a time, shows structured choices only when helpful, checks live availability, and pushes qualified enquiries into the CRM.</p><div class=\"note\"><strong>Conversation first — forms later</strong><br><span>The patient can type naturally. In production WhatsApp, the sender number is captured automatically; name/email are requested only when needed for the booking.</span></div><a class=\"crm\" href=\"/webhook/favfare-demo/crm-ui\" target=\"_blank\">Open staff CRM ↗</a></section><section class=\"phone\"><div class=\"top\"><div class=\"avatar\">F</div><div><strong>Favfare The Clinic</strong><span>Patient Assistant · online</span></div></div><div class=\"status\">Demo · appointment requests require staff confirmation</div><div class=\"chat\"><div class=\"msg\"><div class=\"bubble\">Hi 👋 Welcome to Favfare. What would you like help with today?</div></div></div><div class=\"controls\"><div class=\"quick\"><form method=\"post\" action=\"/webhook/favfare-demo/patient-action\"><input type=\"hidden\" name=\"action\" value=\"chat\"><input type=\"hidden\" name=\"message\" value=\"I want to clean my teeth\"><button>Teeth cleaning</button></form><form method=\"post\" action=\"/webhook/favfare-demo/patient-action\"><input type=\"hidden\" name=\"action\" value=\"chat\"><input type=\"hidden\" name=\"message\" value=\"I want whiter teeth\"><button>Whiter teeth</button></form><form method=\"post\" action=\"/webhook/favfare-demo/patient-action\"><input type=\"hidden\" name=\"action\" value=\"chat\"><input type=\"hidden\" name=\"message\" value=\"Show me your services\"><button>View services</button></form><form method=\"post\" action=\"/webhook/favfare-demo/patient-action\"><input type=\"hidden\" name=\"action\" value=\"chat\"><input type=\"hidden\" name=\"message\" value=\"I want to book an appointment\"><button>Book appointment</button></form></div><form class=\"composer\" method=\"post\" action=\"/webhook/favfare-demo/patient-action\"><input type=\"hidden\" name=\"action\" value=\"chat\"><input name=\"message\" placeholder=\"Type a message\" autocomplete=\"off\" required><button>➤</button></form><div class=\"detected\"><strong>WhatsApp phone:</strong> captured automatically in production</div></div></section></div></body></html>","options":{"responseHeaders":{"entries":[{"name":"Content-Type","value":"text/html; charset=utf-8"},{"name":"Cache-Control","value":"no-store"}]}}},"id":"021c53aa-d394-44fc-8a7f-08fa82a7e83a","name":"Render Patient Simulator","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[40,0]}],"connections":{"Patient Simulator":{"main":[[{"node":"Render Patient Simulator","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"}}